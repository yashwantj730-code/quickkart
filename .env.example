# Copy to .env for local development. Never commit real values.
# Leave MONGODB_URI empty to use the built-in local JSON store (server/.data/db.json).
MONGODB_URI=
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
NODE_ENV=development
PORT=4000
# Optional tuning
AUTH_RATE_LIMIT=20
ORDER_RATE_LIMIT=30
